{
  "npm.packageManager": "pnpm",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,

  // Use the same formatter and lint rules as the workspace scripts.
  "[javascript][javascriptreact][typescript][typescriptreact][vue][html][css][scss][less][json][jsonc][yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.oxc": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "json",
    "jsonc",
    "json5",
    "yaml"
  ],
  "stylelint.validate": ["css", "scss", "less", "vue"],

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/.turbo/**": true,
    "**/.vitepress/cache/**": true,
    "**/dist/**": true,
    "**/.output/**": true,
    "**/coverage/**": true,
    "**/test-results/**": true
  },
  "search.exclude": {
    "**/.turbo": true,
    "**/.vitepress/cache": true,
    "**/dist": true,
    "**/.output": true,
    "**/coverage": true,
    "**/test-results": true
  },

  "i18n-ally.localesPaths": ["packages/locales/src/langs"],
  "i18n-ally.pathMatcher": "{locale}/{namespace}.{ext}",
  "i18n-ally.enabledParsers": ["json"],
  "i18n-ally.sourceLanguage": "en-US",
  "i18n-ally.enabledFrameworks": ["vue"],
  "i18n-ally.keystyle": "nested",
  "i18n-ally.namespace": true,

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "$(capture).test.ts, $(capture).spec.ts, $(capture).d.ts",
    "*.vue": "$(capture).test.ts, $(capture).spec.ts",
    "README.md": "README.*.md",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml",
    "oxlint.config.ts": "oxfmt.config.ts, eslint.config.mjs, stylelint.config.mjs"
  }
}
