{
  "name": "vue-h5-template-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:docs": "pnpm run build --filter=@vh5/docs",
    "dev:docs": "pnpm -F @vh5/docs run dev",
    "build:nutui": "pnpm run build --filter=@vh5/h5-nutui",
    "build:vant": "pnpm run build --filter=@vh5/h5-vant",
    "build:varlet": "pnpm run build --filter=@vh5/h5-varlet",
    "build:play": "pnpm run build --filter=@vh5/playground",
    "clean": "node ./scripts/clean.mjs",
    "create-app": "node scripts/vsh/bin/vsh.mjs create-app",
    "changeset": "pnpm exec changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo-run dev",
    "dev:nutui": "pnpm -F @vh5/h5-nutui run dev",
    "dev:services": "pnpm run dev:services:vant",
    "dev:services:nutui": "pnpm -F @vh5/h5-nutui run dev:services",
    "dev:services:vant": "pnpm -F @vh5/h5-vant run dev:services",
    "dev:services:varlet": "pnpm -F @vh5/h5-varlet run dev:services",
    "dev:varlet": "pnpm -F @vh5/h5-varlet run dev",
    "dev:vant": "pnpm -F @vh5/h5-vant run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "api:generate": "openapi-typescript openapi/schema.yaml -o packages/api-client/src/generated/schema.d.ts && oxfmt --write packages/api-client/src/generated/schema.d.ts",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "postinstall": "pnpm -r run --if-present stub",
    "preinstall": "npx only-allow pnpm",
    "publint": "vsh publint",
    "release": "pnpm exec changeset publish",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test && pnpm run test:e2e:nutui && pnpm run test:e2e:varlet",
    "test:e2e:nutui": "cross-env E2E_APP=nutui playwright test",
    "test:e2e:varlet": "cross-env E2E_APP=varlet playwright test",
    "typecheck": "pnpm -r --if-present run type-check",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpm dlx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vh5/commitlint-config": "workspace:*",
    "@vh5/eslint-config": "workspace:*",
    "@vh5/oxfmt-config": "workspace:*",
    "@vh5/oxlint-config": "workspace:*",
    "@vh5/stylelint-config": "workspace:*",
    "@vh5/tsconfig": "workspace:*",
    "@vh5/turbo-run": "workspace:*",
    "@vh5/vite-config": "workspace:*",
    "@vh5/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "openapi-typescript": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
